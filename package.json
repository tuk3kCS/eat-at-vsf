{
  "name": "eat-at-vsf",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "predev": "npm run generate && tsc -b packages/shared",
    "dev": "concurrently -k -n api,web \"npm run dev -w @vsf/api\" \"npm run dev -w @vsf/web\"",
    "build": "npm run generate && tsc -b && npm run build -w @vsf/web",
    "start": "npm run start -w @vsf/api",
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "admin:create": "tsx --env-file-if-exists=.env prisma/admin.ts",
    "test": "tsx --test tests/unit.test.ts",
    "test:integration": "tsx --test tests/api.test.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.0",
    "concurrently": "^9.2.1",
    "prisma": "7.10.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
